{
  "name": "prism",
  "version": "1.0.0",
  "description": "PRISM - Ask your data questions in plain English",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npx electron . --enable-logging",
    "build": "electron-builder --win"
  },
  "author": "PRISM",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-log": "^5.0.0"
  },
  "build": {
    "appId": "com.prism.desktop",
    "productName": "PRISM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}